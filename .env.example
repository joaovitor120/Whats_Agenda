APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=America/Sao_Paulo
# JSON phone -> name. Use country code + area code + number, digits only. Empty blocks everyone.
WHATSAPP_ALLOWED_CONTACTS='{}'
POSTGRES_ADMIN_PASSWORD=replace-with-separate-random-bootstrap-password
POSTGRES_USER=whatsagenda
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=whatsagenda
DATABASE_URL=postgresql+asyncpg://whatsagenda:replace-with-random-database-password@postgres:5432/whatsagenda
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MAX_OUTPUT_TOKENS=2048
AUDIO_TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_URL=http://transcription:8001
LOCAL_TRANSCRIPTION_API_KEY=
# Set to audio to start the local transcription service.
COMPOSE_PROFILES=
EVOLUTION_API_URL=http://evolution:8080
# Browser access to Evolution Manager. For direct VPS access, run:
# python3 scripts/configure_evolution_access.py --host YOUR_VPS_IP --port 8090
EVOLUTION_BIND_ADDRESS=127.0.0.1
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-independent-random-api-key
EVOLUTION_DB_PASSWORD=replace-with-url-safe-random-database-password
EVOLUTION_DB_ADMIN_PASSWORD=replace-with-independent-bootstrap-password
EVOLUTION_WEBHOOK_BASE_URL=http://api:8000
EVOLUTION_INSTANCE_NAME=whats-agenda
EVOLUTION_INSTANCE_TOKEN=
EVOLUTION_WEBHOOK_SECRET=replace-with-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/oauth/microsoft/callback
TOKEN_ENCRYPTION_KEY=
ADMIN_API_KEY=replace-with-random-secret
DEFAULT_DAY_START=05:00
DEFAULT_DAY_END=23:00
REMINDER_MAX_LATENESS_MINUTES=30
FAKE_CALENDAR=true
FAKE_LLM=true
FAKE_EVOLUTION=true
AUDIO_ENABLED=false
MAX_AUDIO_BYTES=20000000

MAX_AUDIO_SECONDS=600
MAX_TEXT_CHARS=4000
WEBHOOK_MAX_AGE_SECONDS=300
ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
RATE_LIMIT_ENABLED=true
MESSAGES_PER_MINUTE=20
MESSAGES_PER_DAY=200
LLM_REQUESTS_PER_DAY=100
AUDIO_SECONDS_PER_DAY=1800
RETENTION_DAYS=30
